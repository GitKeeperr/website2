# Local development: copy this to .env and fill in YOUR client ID and owner email.
# For a live Railway deployment, put values in Railway > Variables instead of a file.
KONZEI_GOOGLE_CLIENT_ID=YOUR_CLIENT_ID.apps.googleusercontent.com
KONZEI_OWNER_EMAIL=your-private-verified-gmail@gmail.com
KONZEI_PUBLIC_MODE=0
KONZEI_HOST=127.0.0.1
PORT=8765
# Railway-hosted values: KONZEI_PUBLIC_MODE=1 and KONZEI_DATA_DIR=/app/data
# Optional limits: KONZEI_MAX_UPLOAD_GB=1 and KONZEI_MAX_ACTIVE_JOBS=2
